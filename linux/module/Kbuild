# Kbuild file for the KernelGuard Linux module (kernelguard.ko).
# Build with the Makefile in this directory (or `make -C linux`).

obj-m := kernelguard.o

kernelguard-y := kg_main.o kg_state.o kg_comms.o kg_mitigate.o kg_integrity.o kg_pmu.o kg_hw.o kg_input.o

ccflags-y := -I$(src) -I$(src)/../include

# Test hooks (synthetic alert injection) exist only in `make KG_TESTHOOKS=1` builds.
ifeq ($(KG_TESTHOOKS),1)
ccflags-y += -DKG_TESTHOOKS
endif
