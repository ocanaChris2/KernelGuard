root = true

[*]
end_of_line = lf
insert_final_newline = true

# Whitespace hygiene where the code is new and reviewed here; the Windows sources are
# left alone so saving a file in Visual Studio does not produce a noisy diff.
[{linux/**,tools/**,kgbuild/**,.github/**,*.py,*.sh}]
charset = utf-8
trim_trailing_whitespace = true

[linux/**.{c,h}]
indent_style = tab
indent_size = 8

[{Makefile,Kbuild,*.mk}]
indent_style = tab

[*.{py,json,toml}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
