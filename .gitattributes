# Normalize line endings in the repository; choose the working-tree ending per type.
* text=auto

# Must stay LF: run on Linux / in the QEMU guest initramfs
*.sh        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
Makefile    text eol=lf
Kbuild      text eol=lf
*.rules     text eol=lf
*.service   text eol=lf
linux/tests/vm/guest/init text eol=lf

# Must be CRLF on Windows checkouts (cmd.exe mis-parses labels in LF batch files)
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary
*.pdf       binary
*.png       binary
*.ico       binary
*.exe       binary
*.sys       binary
*.pdb       binary
*.obj       binary
